FROM		owasp/modsecurity-crs:nginx-alpine

USER		root
RUN			apk add --no-cache wget

# Create audit log directory
RUN			mkdir -p /var/log/modsecurity/trans
RUN			chown -R nginx:nginx /var/log/modsecurity/trans

RUN			addgroup nginx users

# Remove template so entrypoint doesnt overwrite our config
RUN			rm -f /etc/nginx/templates/nginx.conf.template

USER		nginx

# nginx config
COPY		docker_conf/nginx-dep.conf		/etc/nginx/nginx.conf

# ModSecurity config
COPY		docker_conf/modsecurity/modsecurity.conf	\
			/etc/modsecurity.d/modsecurity.conf

EXPOSE		443 80

