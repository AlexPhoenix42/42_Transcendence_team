# ── Env ──────────────────────────────────
# .env IS committed on purpose: this is a school project and the team
# needs to clone and run instantly from any machine. It holds only
# localhost dev values — a throwaway DB password, a DEBUG-only
# SECRET_KEY, the dev vault's root token (already hardcoded in
# docker-compose-dev.yml), and OAuth placeholders. Real deployment
# secrets live in Vault and in .env.secrets.enc, never here.
#.env
.swp
.swo

# ── JavaScript ───────────────────────────
frontend/node_modules/
frontend/dist/
frontend-react/node_modules/
frontend-react/dist/

# ── Python ───────────────────────────────
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/**/*.pyc
backend/venv/
backend/.venv/

# ── C++ build output ─────────────────────
engine/engine
engine/*.o
engine/*.so
engine/include/chess.hpp   # downloaded separately, not committed

# ── OS junk ──────────────────────────────
.DS_Store
Thumbs.db

# ── Django tmp junk  ─────────────────────
backend/django/django_tmp
backend/django/.mypy_cache
backend/django/requirements.txt.txt
backend/django/media/

.mypy_cache/

# ── Vault secrets  ─────────────────────
vault/approle/
vault/certs/
vault/secrets/

monitoring/

